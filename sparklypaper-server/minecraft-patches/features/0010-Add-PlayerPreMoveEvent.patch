From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MrPowerGamerBR <git@mrpowergamerbr.com>
Date: Fri, 30 Oct 2026 01:31:49 -0300
Subject: [PATCH] Add PlayerPreMoveEvent


diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index dc9dd21791a703ad4ea036da233fa3c42ad7d0c7..9016f3d5aabb0e641269b1b2216a0e2fee5a7c1f 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -1540,8 +1540,8 @@ public class ServerGamePacketListenerImpl
         final double requestedZ,
         final float requestedYRot,
         final float requestedXRot,
-        final boolean isOnGround,
-        final boolean horizontalCollision
+        boolean isOnGround, // SparklyPaper - Add PlayerPreMoveEvent - remove final
+        boolean horizontalCollision // SparklyPaper - Add PlayerPreMoveEvent - remove final
     ) {
         double targetX = clampHorizontal(requestedX);
         double targetY = clampVertical(requestedY);
@@ -1641,7 +1641,7 @@ public class ServerGamePacketListenerImpl
                 xDist = targetX - this.lastGoodX; // Paper - diff on change, used for checking large move vectors above
                 yDist = targetY - this.lastGoodY; // Paper - diff on change, used for checking large move vectors above
                 zDist = targetZ - this.lastGoodZ; // Paper - diff on change, used for checking large move vectors above
-                boolean movedUpwards = yDist > 0.0;
+                boolean movedUpwards = yDist > 0.0; // SparklyPaper - diff on change, used to reset the fall distance, checks if yDist is > 0.0D (player is moving upwards)
                 if (this.player.onGround() && !isOnGround && movedUpwards) {
                     // Paper start - Add PlayerJumpEvent
                     org.bukkit.entity.Player player = this.getCraftPlayer();
@@ -1666,6 +1666,22 @@ public class ServerGamePacketListenerImpl
                 }
 
                 this.player.move(MoverType.PLAYER, new Vec3(xDist, yDist, zDist));
+                // SparklyPaper start - Add PlayerPreMoveEvent event
+                if (net.sparklypower.sparklypaper.event.player.PlayerPreMoveEvent.getHandlerList().getRegisteredListeners().length != 0) {
+                    org.bukkit.entity.Player player = this.getCraftPlayer();
+                    Location from = new Location(player.getWorld(), this.lastPosX, this.lastPosY, this.lastPosZ, this.lastYRot, this.lastXRot); // Get the Players previous Event location.
+                    // The requested values fall back to the player's current position/rotation if the packet does not contain them
+                    Location to = new Location(player.getWorld(), requestedX, requestedY, requestedZ, requestedYRot, requestedXRot);
+
+                    net.sparklypower.sparklypaper.event.player.PlayerPreMoveEvent event = new net.sparklypower.sparklypaper.event.player.PlayerPreMoveEvent(player, from, to, isOnGround, horizontalCollision, movedUpwards);
+
+                    if (event.callEvent()) {
+                        isOnGround = event.isOnGround();
+                        horizontalCollision = event.isHorizontalCollision();
+                        movedUpwards = event.isResetFallDistance();
+                    }
+                }
+                // SparklyPaper end
                 this.player.onGround = isOnGround; // CraftBukkit - SPIGOT-5810, SPIGOT-5835, SPIGOT-6828: reset by this.player.move
                 final boolean didCollide = targetX != this.player.getX() || targetY != this.player.getY() || targetZ != this.player.getZ(); // Paper - needed here as the difference in Y can be reset - also note: this is only a guess at whether collisions took place, floating point errors can make this true when it shouldn't be...
                 // Paper start - prevent position desync
