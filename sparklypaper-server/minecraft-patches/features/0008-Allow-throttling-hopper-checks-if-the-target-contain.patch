From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MrPowerGamerBR <git@mrpowergamerbr.com>
Date: Fri, 30 Oct 2026 01:31:48 -0300
Subject: [PATCH] Allow throttling hopper checks if the target container is
 full


diff --git a/net/minecraft/world/level/block/entity/HopperBlockEntity.java b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
index 803e36f33c706d8484739cb21af25b9289dc8808..7937e1084262b083fe59a4d1011e41ffaef15072 100644
--- a/net/minecraft/world/level/block/entity/HopperBlockEntity.java
+++ b/net/minecraft/world/level/block/entity/HopperBlockEntity.java
@@ -417,6 +417,7 @@ public class HopperBlockEntity extends RandomizableContainerBlockEntity implemen
 
         Direction direction = self.facing.getOpposite();
         if (isFullContainer(container, direction)) {
+            if (level.sparklyPaperConfig.getTicksPer().getHopperCooldownWhenTargetContainerIsFull() != 0) self.setCooldown(level.sparklyPaperConfig.getTicksPer().getHopperCooldownWhenTargetContainerIsFull()); // SparklyPaper - Allow throttling hopper checks if the target container is full
             return false;
         }
 
