     }
 
+    // SparklyPaper start - Add clickLocation to BlockPlaceEvent
+    @ApiStatus.Internal
+    public BlockMultiPlaceEvent(@NotNull List<BlockState> replacedStates, @NotNull Block clicked, @NotNull ItemStack itemInHand, @NotNull Player thePlayer, boolean canBuild, @NotNull org.bukkit.inventory.EquipmentSlot hand, @NotNull Location clickLocation) {
+        super(replacedStates.getFirst().getBlock(), replacedStates.getFirst(), clicked, itemInHand, thePlayer, canBuild, hand, clickLocation);
+        this.replacedStates = ImmutableList.copyOf(replacedStates);
+    }
+    // SparklyPaper end
+
