From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MrPowerGamerBR <git@mrpowergamerbr.com>
Date: Fri, 30 Oct 2026 01:31:48 -0300
Subject: [PATCH] Add per-player chunk rate overrides


diff --git a/src/main/java/org/bukkit/entity/Player.java b/src/main/java/org/bukkit/entity/Player.java
index e763c44f999df2814be8fbc2dfb9eceead2e77db..6ac4eadde5154979058306872f7fcc78363ccd11 100644
--- a/src/main/java/org/bukkit/entity/Player.java
+++ b/src/main/java/org/bukkit/entity/Player.java
@@ -4095,4 +4095,81 @@ public interface Player extends HumanEntity, Conversable, OfflinePlayer, PluginM
      * @return the post-effects
      */
     PlayerPostEffects postEffects();
+
+    // SparklyPaper start - per-player chunk rate overrides
+    /**
+     * Sets the per-player chunk load rate override.
+     * If set to null, uses the global configuration.
+     *
+     * @param rate the chunks per second to load, or null for default
+     */
+    void setChunkLoadRateOverride(@Nullable Double rate);
+
+    /**
+     * Gets the per-player chunk load rate override.
+     *
+     * @return the override rate, or null if using global configuration
+     */
+    @Nullable Double getChunkLoadRateOverride();
+
+    /**
+     * Sets the per-player chunk generation rate override.
+     * If set to null, uses the global configuration.
+     *
+     * @param rate the chunks per second to generate, or null for default
+     */
+    void setChunkGenRateOverride(@Nullable Double rate);
+
+    /**
+     * Gets the per-player chunk generation rate override.
+     *
+     * @return the override rate, or null if using global configuration
+     */
+    @Nullable Double getChunkGenRateOverride();
+
+    /**
+     * Sets the per-player chunk send rate override.
+     * If set to null, uses the global configuration.
+     *
+     * @param rate the chunks per second to send, or null for default
+     */
+    void setChunkSendRateOverride(@Nullable Double rate);
+
+    /**
+     * Gets the per-player chunk send rate override.
+     *
+     * @return the override rate, or null if using global configuration
+     */
+    @Nullable Double getChunkSendRateOverride();
+
+    /**
+     * Sets the per-player max concurrent chunk loads override.
+     * If set to null, uses the global configuration.
+     *
+     * @param limit the maximum concurrent chunk loads, or null for default
+     */
+    void setMaxConcurrentChunkLoadsOverride(@Nullable Long limit);
+
+    /**
+     * Gets the per-player max concurrent chunk loads override.
+     *
+     * @return the override limit, or null if using global configuration
+     */
+    @Nullable Long getMaxConcurrentChunkLoadsOverride();
+
+    /**
+     * Sets the per-player max concurrent chunk generates override.
+     * If set to null, uses the global configuration.
+     *
+     * @param limit the maximum concurrent chunk generates, or null for default
+     */
+    void setMaxConcurrentChunkGeneratesOverride(@Nullable Long limit);
+
+    /**
+     * Gets the per-player max concurrent chunk generates override.
+     *
+     * @return the override limit, or null if using global configuration
+     */
+    @Nullable Long getMaxConcurrentChunkGeneratesOverride();
+    // SparklyPaper end
 }
