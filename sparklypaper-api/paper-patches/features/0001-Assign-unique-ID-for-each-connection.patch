From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MrPowerGamerBR <git@mrpowergamerbr.com>
Date: Mon, 6 Jul 2026 13:41:48 -0300
Subject: [PATCH] Assign unique ID for each connection

It is useful when you need to "bootstrap" a connection, that is, you want to query player data from a external service before the player actually logs in

Using the player's unique ID is not a good solution because of race conditions where a player may have multiple connections in flight, so using a unique ID per connection is more safe

diff --git a/src/main/java/com/destroystokyo/paper/event/player/PlayerConnectionCloseEvent.java b/src/main/java/com/destroystokyo/paper/event/player/PlayerConnectionCloseEvent.java
index 5f5afcdb3c9e669ed0e730c720ad91d16b95602c..941893faaf3ed892607c73f481247b107e3210ac 100644
--- a/src/main/java/com/destroystokyo/paper/event/player/PlayerConnectionCloseEvent.java
+++ b/src/main/java/com/destroystokyo/paper/event/player/PlayerConnectionCloseEvent.java
@@ -42,13 +42,15 @@ public class PlayerConnectionCloseEvent extends Event {
     private final UUID playerUniqueId;
     private final String playerName;
     private final InetAddress ipAddress;
+    private final long connectionId; // SparklyPaper - assign unique ID for each connection
 
     @ApiStatus.Internal
-    public PlayerConnectionCloseEvent(final UUID playerUniqueId, final String playerName, final InetAddress ipAddress, final boolean async) {
+    public PlayerConnectionCloseEvent(final UUID playerUniqueId, final String playerName, final InetAddress ipAddress, final boolean async, final long connectionId) { // SparklyPaper - assign unique ID for each connection
         super(async);
         this.playerUniqueId = playerUniqueId;
         this.playerName = playerName;
         this.ipAddress = ipAddress;
+        this.connectionId = connectionId; // SparklyPaper - assign unique ID for each connection
     }
 
     /**
@@ -80,4 +82,11 @@ public class PlayerConnectionCloseEvent extends Event {
     public static HandlerList getHandlerList() {
         return HANDLER_LIST;
     }
+
+
+    // SparklyPaper start - assign unique ID for each connection
+    public long getConnectionId() {
+        return this.connectionId;
+    }
+    // SparklyPaper end
 }
diff --git a/src/main/java/io/papermc/paper/connection/PlayerCommonConnection.java b/src/main/java/io/papermc/paper/connection/PlayerCommonConnection.java
index 7cba94e4916b64c20ea34ed6626cde7f697d9cd5..38d3429c06a7d3b0bd118160b554cada31df5489 100644
--- a/src/main/java/io/papermc/paper/connection/PlayerCommonConnection.java
+++ b/src/main/java/io/papermc/paper/connection/PlayerCommonConnection.java
@@ -43,4 +43,8 @@ public interface PlayerCommonConnection extends WritablePlayerCookieConnection,
      * @return the client option value of the player
      */
     <T> T getClientOption(ClientOption<T> type);
+
+    // SparklyPaper start - assign unique ID for each connection
+    long getConnectionId();
+    // SparklyPaper end
 }
